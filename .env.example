# Copy to .env and fill in. .env is git-ignored; never commit it.

# Anthropic Console API key (pay-as-you-go)
ANTHROPIC_API_KEY=sk-ant-...

# Model used for recipe generation. Default: current Haiku.
CLAUDE_MODEL=claude-haiku-5-5

# Cost guard: refuse new generations beyond this many per rolling hour.
MAX_GENERATIONS_PER_HOUR=30

# US$ per million tokens, for the usage estimate in Settings.
# Claude Haiku 5.5 list price (prompts under 100K tokens). Update if the model changes.
PRICE_INPUT_PER_MTOK=0.10
PRICE_OUTPUT_PER_MTOK=0.50

TZ=America/New_York

# --- docker-compose only (not read by the app) ---
# Your GitHub username, for the image name ghcr.io/<user>/pantry-chef
GHCR_USER=your-github-user
# Name of the existing Docker network your cloudflared container is on
TUNNEL_NETWORK=cloudflared
